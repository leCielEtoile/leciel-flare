# =============================================================================
# Discord OAuth2設定
# =============================================================================
# Discord Developer Portal (https://discord.com/developers/applications)で
# アプリケーションを作成し、以下の情報を取得してください

# Discord Client ID
NUXT_OAUTH_DISCORD_CLIENT_ID=your_discord_client_id_here

# Discord Client Secret（本番環境ではwrangler secretsで管理することを推奨）
NUXT_OAUTH_DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# =============================================================================
# Discord サーバー認証設定
# =============================================================================
# 特定のDiscordサーバーに参加しているユーザーのみアクセスを許可する場合に設定
# サーバーIDは、Discord開発者モードを有効にして、サーバーを右クリック > IDをコピー
NUXT_DISCORD_GUILD_ID=your_discord_server_id_here

# =============================================================================
# セッション設定
# =============================================================================
# セッション暗号化キー（32文字以上のランダムな文字列）
# 生成例: openssl rand -base64 32
NUXT_SESSION_PASSWORD=your-32-character-or-longer-secret-key-here

# =============================================================================
# サイトURL設定
# =============================================================================
# OAuth2リダイレクトURLの生成に使用されます
# 開発環境: http://localhost:3000
# 本番環境: https://your-worker-name.workers.dev または独自ドメイン
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# サービス名設定
# =============================================================================
# ページに表示されるサービス名
NUXT_PUBLIC_SERVICE_NAME=leciel Flare
